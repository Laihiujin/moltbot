{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenClaw",
  "version": "0.1.0",
  "identifier": "ai.openclaw.app",
  "build": {
    "frontendDist": "../../../dist/control-ui",
    "devUrl": "http://localhost:18789",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ./scripts/prepare-runtime.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "OpenClaw",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://localhost:18789 http://127.0.0.1:18789 ws://localhost:18789 ws://127.0.0.1:18789 'unsafe-inline' 'unsafe-eval' https: wss: data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../onboard.html": "onboard.html",
      "runtime/openclaw/dist/": "dist/",
      "runtime/openclaw/node_modules/": "node_modules/",
      "runtime/openclaw/docs/reference/templates/": "docs/reference/templates/"
    },
    "externalBin": [
      "binaries/node"
    ]
  }
}
